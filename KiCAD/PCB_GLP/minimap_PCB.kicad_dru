(version 1)

# JLCPCB: 2-layer FR4, outer copper 1 oz. Reviewed 2026-10-11.
# Ordinary through-hole pads need a larger ring than vias.
(rule "JLCPCB PTH annular ring"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.25mm)))

(rule "JLCPCB NPTH minimum drill"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.5mm)))

(rule "MX socket internal hole exception"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('ymknlib_Switch_MX_GLP3_17mm:SW_MX_GLP3_1u') && A.Reference == B.Reference && A.Pad_Type == 'Through-hole' && A.Pad_Number == '1' && B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X == 1.75mm")
  (constraint hole_clearance (min 0.35mm))
  (constraint hole_to_hole (min 0.5mm))
  (severity ignore))